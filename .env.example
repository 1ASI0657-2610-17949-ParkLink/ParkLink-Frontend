# ParkLink — Frontend Web
# Variables de entorno para la build de Vite (deben tener prefijo VITE_)

# Google Maps API Key del FRONTEND (distinta a la del backend)
# Restringila por HTTP referrers en Google Cloud Console:
#   http://localhost:* y https://tudominio.vercel.app/*
VITE_GOOGLE_MAPS_API_KEY=

# URL del API Gateway deployado en Vercel. Los clientes no deben apuntar al backend directo.
VITE_API_URL=https://api-gateway-xi-five.vercel.app
